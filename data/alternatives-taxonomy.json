  "_schema": {
    "description": "Executable at-home alternatives shown when FitShield interrupts an ordering page. Two kinds share one presentation shape: full `recipes` and lightweight `quickAlternatives`.",
    "shared": {
      "id": "Stable unique id (kebab-case). Never reused, never renumbered.",
      "title": "Name (English).",
      "description": "One line explaining what it is. Any number it states (minutes, count of ingredients) must match the data below it.",
      "servings": "Exact number of servings the quantities produce.",
      "ingredients": "Structured objects: { quantity, unit, item, note?, optional?, substituteGroup? }.",
      "steps": "Ordered instructions. Must be executable by someone who has not cooked it before.",
      "totalMinutes": "Elapsed time from starting to eating, INCLUDING heating the oven and bringing water to the boil. If a step says to preheat, that time is part of this number.",
      "activeMinutes": "Hands-on effort only. Always <= totalMinutes.",
      "difficulty": "easy | medium",
      "equipment": "Equipment vocabulary from taxonomy.equipment. EVERY item listed is required: the matcher treats the array as AND, so two appliances that are alternatives to each other must never both appear here — declare the one the recipe is written for and put the other in substitutions. [] means no equipment at all.",
      "method": "Effort classification from taxonomy.methods.",
      "diet": "The strictest diet this satisfies: vegan | vegetarian | pescatarian | omnivore.",
      "allergens": "Major allergens present, from taxonomy.allergens. [] means none of the tracked nine.",
      "substitutions": "[{ for, use }] realistic swaps, required when an ingredient is uncommon.",
      "storage": "Leftover / storage guidance, or how long it keeps.",
      "categories": "Blocked categories this answers (taxonomy.categories).",
      "cravings": "Craving types this answers (taxonomy.cravings). A tag is a promise: only tag a craving this entry genuinely answers, never to pad a group.",
      "region": "Cuisine grouping (taxonomy.regions). Not a claim of authenticity.",
      "noCook": "True when nothing is heated at all.",
      "microwave": "True when a microwave alone is enough.",
      "airFryer": "True when an air fryer is the primary appliance.",
      "onePan": "True when cooking happens in one pan/tray.",
      "pantryFriendly": "True when most ingredients are shelf-stable or freezer staples.",
      "calorieRange": "[low, high] per serving, an honest RANGE or omitted. Never a single fake-precise number.",
      "dataVersion": "Schema version of this record."
    },
    "recipesOnly": {
      "prepMinutes": "Preparation before heat is applied.",
      "cookMinutes": "Time with heat applied."
    }
  },
