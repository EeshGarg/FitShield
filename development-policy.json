{
  "_note": "Machine-readable development governance for FitShield. The prose lives in CLAUDE.md; this file is what tools/policy-audit.js enforces, so a rule cannot quietly exist in one and not the other. Runs inside `npm run validate` and `npm test`.",
  "version": 1,

  "completion": {
    "repository_local_open_findings_must_be_zero": true,
    "report_requires_local_queue_empty": true,
    "terminal_negative_verdicts_forbidden": true,
    "probably_fixed_counts_as_open": true,
    "severity_changes_priority_not_completion": true,
    "validators_may_not_be_loosened_to_pass": true
  },

  "agents": {
    "agent_usage_required": true,
    "maximize_safe_parallelism": true,
    "lanes_partitioned_by_file_ownership": true,
    "reviewer_may_not_terminate_task": true,
    "required_agent_definitions": [
      "build-infrastructure-engineer",
      "curated-data-engineer",
      "localization-engineer",
      "privacy-security-engineer",
      "qa-engineer",
      "release-engineer",
      "ui-ux-engineer"
    ]
  },

  "_forbidden_note": "Terms that may never end a session, a review, or a report. A report containing one of these as a heading for repository-local work is a policy failure, not a status.",
  "forbidden_terminal_verdicts": [
    "NOT READY",
    "RELEASE CANDIDATE",
    "SKEPTICAL-BUYER READY",
    "PASS WITH LIMITATIONS",
    "DO NOT SHIP",
    "NEEDS ANOTHER PASS"
  ],

  "_deferral_note": "Section headings a final report may not use for work that is still performable in this repository. External-only items are classified separately.",
  "forbidden_report_sections": [
    "Deferred",
    "Follow-up",
    "Follow-ups",
    "Next session",
    "Remaining work",
    "Open findings",
    "Not verified",
    "Deferred non-release ideas"
  ],

  "external_only_allowed": [
    {
      "id": "safari-xcode",
      "reason": "xcrun safari-web-extension-converter is macOS-only",
      "requires": "macOS with Xcode",
      "local_prerequisites_complete": true
    },
    {
      "id": "android-apk",
      "reason": "Android SDK and Gradle are not installed in this environment",
      "requires": "a machine with the Android SDK",
      "local_prerequisites_complete": true
    },
    {
      "id": "screen-reader",
      "reason": "no assistive technology available to listen with",
      "requires": "NVDA, JAWS or VoiceOver",
      "local_prerequisites_complete": true
    },
    {
      "id": "human-acceptance",
      "reason": "subjective judgement cannot be automated",
      "requires": "a person",
      "local_prerequisites_complete": true
    }
  ],

  "product_invariants": {
    "permissions": ["storage", "declarativeNetRequest", "alarms"],
    "runtime_network_requests_allowed": false,
    "new_dependencies_allowed": false,
    "telemetry_allowed": false,
    "may_reset_user_data_silently": false
  }
}
