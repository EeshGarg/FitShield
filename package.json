{
  "name": "fitshield",
  "version": "0.55.0",
  "description": "FitShield browser extension: it interrupts impulsive food-delivery and fast-food ordering, then offers something you could make instead. Entirely local.",
  "private": true,
  "scripts": {
    "test": "node --test",
    "validate": "node tools/validate-all.js",
    "validate:datasets": "node tools/validate-datasets.js",
    "validate:alternatives": "node tools/alternatives-audit.js",
    "validate:aliases": "node tools/alias-audit.js",
    "validate:countries": "node tools/country-audit.js",
    "validate:categories": "node tools/category-audit.js",
    "validate:locales": "node tools/locale-parity.js",
    "validate:hybrids": "node tools/locale-hybrid-audit.js",
    "validate:policy": "node tools/policy-audit.js",
    "locales:status": "node tools/locale-status.js",
    "locales:prune": "node tools/locale-prune.js",
    "validate:docs": "node tools/changelog-validator.js",
    "validate:assets": "node tools/assets-check.js",
    "validate:extension": "node tools/extension-audit.js",
    "validate:sw": "node tools/service-worker-audit.js",
    "validate:sync": "node tools/sync-audit.js",
    "validate:a11y": "node tools/browser-a11y-audit.js",
    "validate:safari": "node tools/safari-audit.js",
    "sync": "node tools/sync-extension.js",
    "generate:alternatives": "node tools/build-alternatives.js",
    "verify:unpacked": "node tools/verify-unpacked.js",
    "validate:android": "node tools/android-audit.js",
    "validate:android-packages": "node tools/validate-android-packages.js",
    "generate:android": "node tools/generate-android-rules.js",
    "generate:android-packages": "node tools/generate-android-packages.js",
    "port:android-apps": "node tools/port-android-apps.js",
    "build": "node build.js",
    "build:android": "node tools/build-android.js",
    "toolchain:android": "node tools/provision-android-toolchain.js",
    "capture": "node tools/capture-surfaces.js",
    "build:safari": "node tools/build-safari.js",
    "build:all": "node build.js && node tools/build-android.js"
  },
  "license": "GPL-3.0-or-later"
}
