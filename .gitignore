*.zip
dist/

# Claude Code: the specialist agent definitions in .claude/agents/ are shared
# project tooling (CLAUDE.md §4 requires them). Everything else under .claude/
# (settings.local.json, personal commands) stays local.
.claude/*
!.claude/agents/

# Android build artifacts (the project scaffolding is tracked; build output is not).
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
*.aab

# Release signing — NEVER commit keystores or their passwords.
keystore.properties
android/keystore.properties
*.jks
*.keystore

# graphify knowledge-graph output (local analysis, rebuilt on demand).
graphify-out/

# Translator worklists written by tools/locale-status.js --todo
translations/

# Session-local acceptance work queue (regenerated per audit pass).
# .queue.closures/ is session-local for the same reason: it records how one
# pass's findings were closed, and a later pass regenerates its own findings.
.queue.json
.queue/
.queue-source.json
.queue.closures/
