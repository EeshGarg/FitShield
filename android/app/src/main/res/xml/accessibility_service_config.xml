<?xml version="1.0" encoding="utf-8"?>
<!--
  FitShield app-blocking AccessibilityService config.

  Deliberately minimal: it only listens for window-state changes to learn WHICH
  app came to the foreground (event.getPackageName()). It does NOT retrieve window
  content (canRetrieveWindowContent="false"), so it cannot read on-screen text,
  messages, or passwords. Nothing leaves the device.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:summary="@string/accessibility_summary"
    android:description="@string/accessibility_description" />
