<?xml version="1.0" encoding="utf-8"?>
<!--
  FitShield Android adapter manifest.

  Minimal permissions by design (enforced by tools/android-audit.js):
    INTERNET             - relay ALLOWED connections to the destination IP the
                           client already chose (no DNS is forwarded anywhere).
    FOREGROUND_SERVICE   - the VpnService (and the optional keep-alive) run as
                           foreground services.
    POST_NOTIFICATIONS   - the required ongoing foreground-service notification
                           (Android 13+).
    SYSTEM_ALERT_WINDOW  - "display over other apps": lets the app-block screen
                           reliably appear over a blocked food app (background
                           activity-launch exemption). User-granted; optional —
                           blocking still works without it on most devices. Used
                           ONLY to show the block screen for selected food apps;
                           FitShield never reads screen/message content.
    RECEIVE_BOOT_COMPLETED - restore the user's OWN setting after a restart.
                           Rebooting kills the VpnService, and without this the
                           user is left unprotected with nothing telling them so
                           — the opposite of what a blocker promises. FitShield
                           restarts filtering ONLY when the user had it switched
                           on when the device shut down (the stored instruction
                           is written solely by an explicit enable/disable, never
                           by the OS ending the service); a user who had it off
                           gets no service and no notification. No other work is
                           done at boot: nothing is uploaded, no data is read,
                           and no other component is started. See BootReceiver.kt
                           and RestorePolicy.kt.

  App-blocking uses an AccessibilityService (guarded by BIND_ACCESSIBILITY_SERVICE
  on the <service>, which the OS grants). It is configured to read ONLY the
  foreground package name (canRetrieveWindowContent="false") — never screen
  content — and is a user opt-in enabled from system Accessibility settings.

  Deliberately NOT requested: PACKAGE_USAGE_STATS (no usage access),
  QUERY_ALL_PACKAGES (a narrowly scoped <queries> for launchable apps is used
  instead — see below), device admin.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required on Android 14+ (the build targets 36) to run a foreground service of
         type "specialUse" — the type the VpnService declares below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional "display over other apps": makes the block screen launch reliably
         over a blocked app. Used only to show the FitShield block screen for
         selected food apps; no screen/message content is ever read. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Restore the user's own choice after a restart. Used for nothing else:
         the receiver below starts the connection filter if — and only if — the
         user had it switched on, and otherwise does nothing at all. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Package visibility (Android 11+). The block screen sends the blocked app to
      the background before it appears, so "Open anyway" must re-open the app by
      its launch intent. This scoped <queries> makes launchable apps resolvable
      via getLaunchIntentForPackage — it is NOT QUERY_ALL_PACKAGES and grants no
      access to any app's data, only the ability to start its launcher activity.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
      android:icon was missing entirely, so FitShield installed as Android's grey
      placeholder — the first thing a user sees after downloading, and something
      the 512x512 Play listing icon does not fix. Both entries point at adaptive
      icons; minSdk is 26, so there is no device that cannot resolve them.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitShield">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Local connection-filter VPN. Guarded by BIND_VPN_SERVICE (the OS
          enforces that only the system can bind a VpnService). This is NOT a
          tunnel to any server and does NOT decrypt traffic — it reads only the
          cleartext destination host (TLS SNI / HTTP Host), resets blocked
          connections, and relays the rest to the client's chosen IP. DNS is
          never intercepted or forwarded. See docs/ANDROID.md.
        -->
        <service
            android:name=".FitShieldVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local on-device TLS-SNI/HTTP-Host connection filtering for mindful food-ordering blocking" />
        </service>

        <!--
          App-blocking AccessibilityService. Detects when a blocked food app comes
          to the foreground and shows the FitShield intervention (BlockActivity).
          It reads ONLY the foreground package name (config sets
          canRetrieveWindowContent="false") — no screen content — and nothing
          leaves the device. User opt-in via system Accessibility settings.
        -->
        <service
            android:name=".FitShieldAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Optional "background protection" foreground service (opt-in, OFF by
          default). Runs only a quiet ongoing notification to keep the process
          resident so OEM battery managers don't pause app blocking after long
          idle. Does no work and reads nothing. Reuses FOREGROUND_SERVICE /
          FOREGROUND_SERVICE_SPECIAL_USE / POST_NOTIFICATIONS (already declared).
        -->
        <service
            android:name=".AppBlockKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps on-device food-app blocking responsive in the background" />
        </service>

        <!--
          Restart the connection filter after a reboot or an app update — both
          of which end the VpnService without the user asking for anything.

          It restores ONLY what the user chose: BootReceiver reads the stored
          instruction (written exclusively by an explicit enable/disable in the
          app) and does nothing at all when that says off. When Android no longer
          holds VPN consent, it posts one notification offering a single tap
          rather than starting anything. Both actions are protected system
          broadcasts, so no other app can trigger this.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Native block/intervention screen (WebView), launched over a blocked app.
          Own task + excluded from recents so dismissing it never lands the user
          back inside the blocked app (see BlockActivity.goHome()).

          android:configChanges — the pause is a COUNTDOWN, and without it Android
          destroys and recreates this activity on every rotation. The WebView
          reloads block.html, startTimer() runs again from timerSeconds, and the
          wait starts over: measured on a Galaxy S24 Ultra it ran 25s -> 18s, and
          then a rotation put it back to 57s. Turning the phone should not reset
          the thing the user is waiting out. Handling these configurations here
          keeps the WebView alive; it reflows through CSS.
        -->
        <activity
            android:name=".BlockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.FitShield" />
    </application>
</manifest>
