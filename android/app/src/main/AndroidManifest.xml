<?xml version="1.0" encoding="utf-8"?>
<!--
  FitShield Android adapter manifest.

  Minimal permissions by design (enforced by tools/android-audit.js):
    INTERNET             - forward ALLOWED DNS queries to the upstream resolver.
    FOREGROUND_SERVICE   - a VPN runs as a foreground service.
    POST_NOTIFICATIONS   - the required ongoing VPN notification (Android 13+).
    SYSTEM_ALERT_WINDOW  - "display over other apps": lets the app-block screen
                           reliably appear over a blocked food app (background
                           activity-launch exemption). User-granted; optional —
                           blocking still works without it on most devices. Used
                           ONLY to show the block screen for selected food apps;
                           FitShield never reads screen/message content.

  App-blocking uses an AccessibilityService (guarded by BIND_ACCESSIBILITY_SERVICE
  on the <service>, which the OS grants). It is configured to read ONLY the
  foreground package name (canRetrieveWindowContent="false") — never screen
  content — and is a user opt-in enabled from system Accessibility settings.

  Deliberately NOT requested: RECEIVE_BOOT_COMPLETED (no boot startup),
  PACKAGE_USAGE_STATS (no usage access), QUERY_ALL_PACKAGES (a narrowly
  scoped <queries> for launchable apps is used instead — see below),
  device admin.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required on Android 14+ (targetSdk 34) to run a foreground service of
         type "specialUse" — the type the VpnService declares below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional "display over other apps": makes the block screen launch reliably
         over a blocked app. Used only to show the FitShield block screen for
         selected food apps; no screen/message content is ever read. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      Package visibility (Android 11+). The block screen sends the blocked app to
      the background before it appears, so "Open anyway" must re-open the app by
      its launch intent. This scoped <queries> makes launchable apps resolvable
      via getLaunchIntentForPackage — it is NOT QUERY_ALL_PACKAGES and grants no
      access to any app's data, only the ability to start its launcher activity.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitShield">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Local DNS-filtering VPN. Guarded by BIND_VPN_SERVICE (the OS enforces
          that only the system can bind a VpnService). This is NOT a tunnel and
          performs NO traffic inspection — it only sinkholes DNS for blocked
          domains and forwards everything else. See docs/ANDROID.md.
        -->
        <service
            android:name=".FitShieldVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local on-device DNS content filtering for mindful food-ordering blocking" />
        </service>

        <!--
          App-blocking AccessibilityService. Detects when a blocked food app comes
          to the foreground and shows the FitShield intervention (BlockActivity).
          It reads ONLY the foreground package name (config sets
          canRetrieveWindowContent="false") — no screen content — and nothing
          leaves the device. User opt-in via system Accessibility settings.
        -->
        <service
            android:name=".FitShieldAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Native block/intervention screen (WebView), launched over a blocked app.
          Own task + excluded from recents so dismissing it never lands the user
          back inside the blocked app (see BlockActivity.goHome()).
        -->
        <activity
            android:name=".BlockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.FitShield" />
    </application>
</manifest>
